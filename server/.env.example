# ---- AI (Vercel AI Gateway) ------------------------------------------------------------
AI_MODEL=openai/gpt-5-mini            # default text model (AI Gateway id)
AI_EVALUATION_MODEL=typesafe-ai/jev  # decides whether shared text with a URL is a link to open; "off" = always summarise the text
AI_IMAGE_MODEL=google/gemini-3.1-flash-lite-image   # optional, enables the "illustration" OG style (chroma-keyed cut-out)
AI_IMAGE_TIMEOUT_MS=60000             # optional, per-attempt budget for the illustration call
AI_EMBEDDING_MODEL=openai/text-embedding-3-small   # natural-language search embeddings; "off" = keyword search only
SEARCH_MAX_DISTANCE=0.65              # optional, max cosine distance for a semantic search match (0-2)
AI_GATEWAY_API_KEY=                   # optional on Vercel (OIDC is used automatically)

# ---- Database (Turso / libsql) ---------------------------------------------------------
TURSO_DATABASE_URL=libsql://summary-chip-<org>.turso.io   # or file:local.db for local dev
TURSO_AUTH_TOKEN=

# ---- Storage (Cloudflare R2) ----------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=summary-chip
R2_PUBLIC_BASE_URL=                   # optional: bucket custom domain, e.g. https://cdn.summary.rxlab.app (public OG images served from Cloudflare CDN)

# ---- Link crawling (Cloudflare Browser Rendering) ------------------------------------
# Optional: render shared links in headless Chromium so JS-built pages can be summarised.
# Token needs the "Browser Rendering - Edit" permission. Unset = plain fetch only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- Auth (RxAuth bearer tokens for /api/v1) ------------------------------------------
AUTH_ISSUER=https://auth.rxlab.app
IOS_OAUTH_CLIENT_ID=
RXLAB_ALLOWED_CLIENT_IDS=             # comma-separated extra client ids

# ---- Summary push notifications (Apple APNs) -------------------------------------------
# Optional: unset = no push delivery. Use a .p8 APNs signing key, never commit it.
APNS_KEY_ID=
APNS_TEAM_ID=                        # team that owns the Chippy App ID/signing key
APNS_PRIVATE_KEY=                    # PEM .p8 contents; literal \n escapes are supported
APNS_BUNDLE_ID=com.rxlab.summary-chip

# Flight tracking (docs/flights.md). Without a key, development uses a mock provider.
AERODATABOX_API_KEY=                 # RapidAPI key for AeroDataBox
AERODATABOX_HOST=aerodatabox.p.rapidapi.com
FLIGHT_PROVIDER=                     # aerodatabox | mock (default: aerodatabox when the key is set)

# ---- RxSubscription (usage and top-ups) -------------------------------------------------
RX_SUBSCRIPTION_URL=https://subscription.rxlab.app
# Use keys from Chippy's own RxSubscription application.
RX_SUBSCRIPTION_PRODUCTION_API_KEY=
RX_SUBSCRIPTION_SANDBOX_API_KEY=
RX_SUBSCRIPTION_PRODUCTION_PUBLISHABLE_KEY=
RX_SUBSCRIPTION_SANDBOX_PUBLISHABLE_KEY=
RX_SUBSCRIPTION_XCODE_API_KEY=
RX_SUBSCRIPTION_XCODE_PUBLISHABLE_KEY=
# Authenticated RxAuth subjects permitted to use Xcode billing on a deployed server.
RX_SUBSCRIPTION_XCODE_USER_IDS=
# Points charged per US$1 of chat model API cost (rounded up per turn). Default 50 ≈ 100 points / US$1.99.
CHAT_POINTS_PER_USD=50
APPLE_BUNDLE_ID=com.rxlab.summary-chip
# APP_STORE_ID below is required for Apple-signed sandbox/production routing.
# Local/single-environment alternative: use matching key prefixes.
# RX_SUBSCRIPTION_ENVIRONMENT=sandbox
# RX_SUBSCRIPTION_API_KEY=
# RX_SUBSCRIPTION_PUBLISHABLE_KEY=

# ---- Site ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://summary.rxlab.app
DEFAULT_TTL_DAYS=7                    # one of 1, 3, 7, 30, 90, 365 (or "never")
CRON_SECRET=                          # Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
APPLE_TEAM_ID=P9KK452K8P
APP_STORE_ID=                         # optional, adds app-id to the Smart App Banner

# ---- Local development only (ignored when NODE_ENV=production) ------------------------
# SUMMARY_MOCK_SERVICES=true          # mock AI provider + in-memory object store
# SUMMARY_OG_REMOTE_ASSETS=false      # skip Google Fonts / Twemoji fetches in OG rendering
