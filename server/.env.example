# ---- AI (Vercel AI Gateway) ------------------------------------------------------------
AI_MODEL=openai/gpt-5-mini            # default text model (AI Gateway id)
AI_IMAGE_MODEL=google/gemini-3.1-flash-lite-image   # optional, enables the "illustration" OG style (chroma-keyed cut-out)
AI_IMAGE_TIMEOUT_MS=60000             # optional, per-attempt budget for the illustration call
AI_GATEWAY_API_KEY=                   # optional on Vercel (OIDC is used automatically)

# ---- Database (Turso / libsql) ---------------------------------------------------------
TURSO_DATABASE_URL=libsql://summary-chip-<org>.turso.io   # or file:local.db for local dev
TURSO_AUTH_TOKEN=

# ---- Storage (Cloudflare R2) ----------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=summary-chip
R2_PUBLIC_BASE_URL=                   # optional: bucket custom domain, e.g. https://cdn.summary.rxlab.app (public OG images served from Cloudflare CDN)

# ---- Auth (RxAuth bearer tokens for /api/v1) ------------------------------------------
AUTH_ISSUER=https://auth.rxlab.app
IOS_OAUTH_CLIENT_ID=
RXLAB_ALLOWED_CLIENT_IDS=             # comma-separated extra client ids

# ---- Site ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://summary.rxlab.app
DEFAULT_TTL_DAYS=7                    # one of 1, 3, 7, 30, 90, 365 (or "never")
CRON_SECRET=                          # Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
APPLE_TEAM_ID=P9KK452K8P
APP_STORE_ID=                         # optional, adds app-id to the Smart App Banner

# ---- Local development only (ignored when NODE_ENV=production) ------------------------
# SUMMARY_MOCK_SERVICES=true          # mock AI provider + in-memory object store
# SUMMARY_OG_REMOTE_ASSETS=false      # skip Google Fonts / Twemoji fetches in OG rendering
