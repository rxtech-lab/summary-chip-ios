{
  "sourceLanguage" : "en",
  "strings" : {
    "Chippy" : {
      "shouldTranslate" : false
    },
    "Chippy turns any web page, PDF or text into a short summary with a beautiful link preview." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chippy 可将任何网页、PDF 或文本变成简短的摘要，并配上精美的链接预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chippy 可將任何網頁、PDF 或文字變成簡短的摘要，並附上精美的連結預覽。"
          }
        }
      }
    },
    "Couldn't load the summary" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载摘要"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入摘要"
          }
        }
      }
    },
    "Get Chippy" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取 Chippy"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取得 Chippy"
          }
        }
      }
    },
    "Get the full app" : {
