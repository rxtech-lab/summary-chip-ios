          "stringUnit" : {
            "state" : "translated",
            "value" : "取得完整版 App"
          }
        }
      }
    },
    "Its owner made it private, or the link has expired." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有者已将其设为私密，或链接已过期。"
