    "Name the key after the agent or device that uses it. The key gives full access to add, search and list your summaries." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用使用它的智能体或设备来命名此密钥。此密钥拥有添加、搜索和列出你摘要的完整权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用使用它的代理程式或裝置來命名此金鑰。此金鑰擁有新增、搜尋和列出你摘要的完整權限。"
          }
        }
      }
