    "Checkout opens securely in your browser. Points are added to your account once payment completes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将在浏览器中安全打开结账页面。付款完成后，积分会添加到你的账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
