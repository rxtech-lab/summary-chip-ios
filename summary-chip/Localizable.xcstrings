    "Agents using this key stop working immediately. This can’t be undone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此密钥的智能体将立即停止工作。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
