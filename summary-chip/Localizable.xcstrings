    "A new preview image replaces the current one. Links that were already shared show the new image once apps refresh their preview." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的预览图将替换当前预览图。已分享的链接会在应用刷新预览后显示新图片。"
