<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>$(SUMMARY_CHIP_PUSH_ENVIRONMENT)</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:summary.rxlab.app</string>
		<string>webcredentials:rxlab.app</string>
		<string>appclips:summary.rxlab.app</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.rxlab.summary-chip</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.rxlab.summary-chip.shared</string>
	</array>
</dict>
</plist>
